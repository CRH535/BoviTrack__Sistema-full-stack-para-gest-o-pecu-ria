# URL base da API Express. Nao inclua /api nem uma barra no final.
# Desenvolvimento local: o backend usa a porta 3000 por padrao.
VITE_API_URL=http://localhost:3000

# Em producao, configure VITE_API_URL nas variaveis de ambiente do frontend
# (por exemplo, na Vercel) com a URL HTTPS publica do backend.
# Nao coloque JWT_SECRET, DATABASE_URL ou outras credenciais em variaveis VITE_*:
# elas sao incorporadas ao bundle e ficam visiveis no navegador.
