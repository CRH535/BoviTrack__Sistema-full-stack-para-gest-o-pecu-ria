# Conexao usada pelo backend depois da migracao.
# Copie a URI pelo botao Connect do Supabase. Nao versionar a URI real.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Em producao use verify-full e informe a CA confiavel por arquivo ou base64.
# DB_SSL=verify-full
# DB_SSL_CA_PATH=./certificates/prod-ca-2021.crt
# DB_SSL_CA_BASE64=

# Ajustes opcionais do pool do backend.
DB_POOL_MAX=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=15000

# Conexao administrativa usada por npm run migrate:supabase e
# npm run migrate:security. Nunca reutilize esta URL no runtime da Vercel.
# Prefira Direct connection ou Session pooler, ambos na porta 5432.
# SUPABASE_MIGRATION_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Origem da migracao. Pode ser uma URL ou as cinco variaveis DB_* abaixo.
# LOCAL_DATABASE_URL=postgresql://postgres:SENHA@localhost:5432/bovitrack
DB_USER=postgres
DB_HOST=localhost
DB_NAME=bovitrack
DB_PASSWORD=SENHA_LOCAL
DB_PORT=5432

PORT=3000
# Em producao, informe a URL do frontend na Vercel. Para mais de uma origem,
# separe as URLs por virgula. Localhost e permitido automaticamente somente
# fora de producao.
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_LOCALHOST=false
CSRF_ALLOW_NO_ORIGIN=true
APP_TIMEZONE=America/Sao_Paulo
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=bovitrack-api
JWT_AUDIENCE=bovitrack-web
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
JSON_BODY_LIMIT=100kb

# Se frontend e backend estiverem em projetos/dominios Vercel diferentes, use
# COOKIE_SAME_SITE=none e COOKIE_SECURE=true nas variaveis do backend na Vercel.

# Usadas somente por npm run migrate:auth.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@bovitrack.local
ADMIN_SENHA=troque_por_uma_senha_segura

# Trava para suítes que criam/excluem dados. Use true apenas em homologação.
ALLOW_TEST_DB_WRITES=false
